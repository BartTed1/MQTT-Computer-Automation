API_KEY_EXECUTION_SYS=changeme
API_KEY_EXTERNAL_ORCHESTRATOR=changeme
REGISTRATION_TOKEN_KEY=changeme
REGISTRATION_TOKEN_TTL_MINUTES=15
COMMAND_TIMEOUT_SECONDS=60
# Optional: if both are set, the MQTT broker serves TLS on MQTT_TLS_PORT instead
# of plaintext port 1883. Leave unset for local development without certs.
MQTT_TLS_CERT_PATH=
MQTT_TLS_KEY_PATH=
MQTT_TLS_PORT=8883